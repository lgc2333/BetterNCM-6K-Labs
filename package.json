{
  "name": "better-ncm-6k-labs",
  "version": "0",
  "private": true,
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "description": "",
  "author": "LgCuwukii <lgc2333@126.com>",
  "license": "MIT",
  "repository": "https://github.com/lgc2333/BetterNCM-6K-Labs",
  "main": "index.js",
  "scripts": {
    "build:js:dev": "esbuild ./src/main.ts --bundle --outdir=dist --sourcemap=inline --target=chrome91",
    "build:js": "esbuild ./src/main.ts --bundle --minify --outdir=dist --target=chrome91",
    "build:native": "tsx ./scripts/build-native.ts && tsx ../../scripts/post-build.ts",
    "build:dev": "pnpm run build:js:dev && pnpm run build:native",
    "build": "pnpm run build:js && pnpm run build:native",
    "apply": "tsx ../../scripts/apply.ts",
    "analyze": "esbuild --bundle ./src/main.ts --outdir=dist --minify --analyze=verbose",
    "check": "tsc -b --noEmit && cargo test --manifest-path ./native/Cargo.toml && cargo clippy --manifest-path ./native/Cargo.toml --target x86_64-pc-windows-msvc -- -D warnings"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:"
  }
}
